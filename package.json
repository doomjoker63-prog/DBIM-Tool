{
  "name": "dbim-auditor",
  "version": "1.0.0",
  "description": "CLI that crawls a government website with Chromium and tests it against DBIM v3.0",
  "type": "module",
  "bin": {
    "dbim": "dist/cli.js"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@axe-core/playwright": "^4.14.0",
    "commander": "^15.0.0",
    "dictionary-en-gb": "^3.0.0",
    "exceljs": "^4.4.0",
    "nspell": "^2.1.5",
    "playwright": "^1.64.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/nspell": "^2.1.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
